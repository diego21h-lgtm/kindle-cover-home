        {
          "name": "Selecionar (nao abre livro)",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library select"
        },
        {
          "name": "Exibir novamente",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library show"
        },
        {
          "name": "Encerrar sessao / retornar ao KUAL",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library back"
