{
  "items": [
    {
      "name": "Iniciar Kindle Cover Home",
      "priority": 0,
      "action": "/bin/sh",
      "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh launch scan",
      "exitmenu": false
    },
    {
      "name": "Gerar catalogo de demonstracao (6 livros)",
      "priority": 1,
      "action": "/bin/sh",
      "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh launch demo",
      "exitmenu": false
    },
    {
      "name": "Teste 0 - acionamento direto KUAL",
      "action": "/bin/sh",
      "params": "-c 'printf \"%s\\n\" \"KUAL_DISPATCH_0.2.1\" > /mnt/us/coverhome-kual-dispatch.txt'",
      "exitmenu": false
    },
    {
      "name": "Teste basico KUAL",
      "action": "/bin/sh",
      "params": "/mnt/us/extensions/kindlecoverhome/bin/kual-basic.sh",
      "exitmenu": false
    },
    {
      "name": "Teste progressivo - caminhos e logs",
      "action": "/bin/sh",
      "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh probe diagnose",
      "exitmenu": false
    },
    {
      "name": "Diagnostico 0.2.1 (com rastreamento)",
      "action": "/bin/sh",
      "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh launch diagnose",
      "exitmenu": false
    },
    {
      "name": "Biblioteca visual 0.2 - experimental",
      "items": [
        {
          "name": "Mostrar demonstracao (requer habilitacao)",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library demo"
        },
        {
          "name": "Mostrar catalogo preparado no PC",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library catalog"
        },
        {
          "name": "Cima",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library up"
        },
        {
          "name": "Baixo",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library down"
        },
        {
          "name": "Esquerda",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library left"
        },
        {
          "name": "Direita",
          "action": "/bin/sh",
          "exitmenu": false,
          "params": "/mnt/us/extensions/kindlecoverhome/bin/bootstrap.sh library right"
